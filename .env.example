# =============================================================================
# Agentic Software Development Workflow — Environment Variables Template
#
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in your real values in .env
#   3. Never commit .env — it is listed in .gitignore
#
# All variables are read by app/config.py at startup.
# Missing required variables will cause the application to refuse to start
# with a clear validation error.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# SQLAlchemy connection string.
# For development, SQLite is used (no separate DB server needed).
# Format: sqlite+aiosqlite:///./path/to/file.db
# Use ":memory:" for in-memory DB in tests (handled automatically).
DATABASE_URL=sqlite+aiosqlite:///./jobs.db

# -----------------------------------------------------------------------------
# GitHub Integration
# -----------------------------------------------------------------------------
# A GitHub Personal Access Token (PAT) with the following fine-grained scopes:
#   - Contents: Read and Write  (clone repo, push branch)
#   - Pull Requests: Write      (open draft PRs)
#   - Issues: Read              (fetch issue data)
#
# Create one at: https://github.com/settings/tokens?type=beta
# NEVER use a classic token with full repo scope.
GITHUB_TOKEN=your_github_personal_access_token_here

# Base URL for the GitHub REST API. Only change this for GitHub Enterprise.
GITHUB_API_BASE_URL=https://api.github.com

# -----------------------------------------------------------------------------
# LLM Provider
# -----------------------------------------------------------------------------
# API key for your LLM provider (e.g. OpenAI, Anthropic).
# This value is treated as a secret — it will never appear in logs or tracebacks.
LLM_API_KEY=your_llm_api_key_here

# The model identifier to use for plan and code generation.
# Examples: gpt-4o, gpt-4o-mini, claude-3-5-sonnet-20241022
LLM_MODEL=gpt-4o

# Base URL for LLM API calls.
# Change this to point at a local Ollama instance or a proxy.
# OpenAI default: https://api.openai.com/v1
LLM_API_BASE_URL=https://api.openai.com/v1

# -----------------------------------------------------------------------------
# Agent Behaviour
# -----------------------------------------------------------------------------
# Directory where the agent clones target repositories.
# Created automatically at startup if it does not exist.
# This directory is listed in .gitignore.
WORKSPACE_DIR=./workspaces

# Maximum number of times the agent will retry code generation after test failures.
MAX_RETRIES=3

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

